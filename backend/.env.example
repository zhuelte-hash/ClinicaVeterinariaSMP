DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fullstack_app
# Neon: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Correo de verificación y recuperación: configura un servidor SMTP real.
# Ejemplo habitual: puerto 587 con STARTTLS; puerto 465 con SMTP_SSL=true y SMTP_STARTTLS=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=
FRONTEND_URL=http://localhost:4200
# manual: abre WhatsApp normal para que una persona envíe el mensaje.
# También disponibles: meta y twilio (Sandbox clásico en ventana de 24 h).
WHATSAPP_PROVIDER=manual
# Twilio Console: Account SID y Auth Token reales (no las credenciales de prueba).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Copiar el emisor exacto que aparece en el Sandbox.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Origen HTTPS público del backend, sin ruta, query ni barra final.
TWILIO_PUBLIC_URL=
# Firma y verificación del webhook de WhatsApp Cloud API.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Tarea automática de inasistencia
APPOINTMENT_TOLERANCE_MINUTES=15
APPOINTMENT_WORKER_INTERVAL_SECONDS=30
BOOKING_URL=http://localhost:4200/reservar-cita
# WhatsApp Business Cloud API. Requiere una plantilla aprobada en Meta.
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_CONFIRMED=cita_confirmada
WHATSAPP_TEMPLATE_NO_SHOW=cita_no_asistio

# Compras web: completar con datos reales. Los métodos incompletos se deshabilitan.
# Estos son datos públicos de cobro, nunca claves de acceso a la cuenta.
PURCHASE_WHATSAPP_NUMBER=
PURCHASE_DELIVERY_COST=10.00
PURCHASE_YAPE_HOLDER=
PURCHASE_YAPE_PHONE=
PURCHASE_YAPE_QR_URL=
PURCHASE_PLIN_HOLDER=
PURCHASE_PLIN_PHONE=
PURCHASE_PLIN_QR_URL=
